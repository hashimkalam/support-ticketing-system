# Copy to .env before running docker compose.
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets

DEBUG=true

# CORS_ORIGINS must be JSON when overridden from the environment.
CORS_ORIGINS=["http://localhost:5173"]

# The browser (not the compose network) calls the API, so this must be a
# host-reachable address.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Only needed when running the API outside Docker (host -> published port).
# DATABASE_URL=postgresql+psycopg2://tickets:tickets@localhost:5432/tickets
