# Copy to .env before running docker compose.
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets

# Verbose FastAPI/Starlette behaviour. Keep false so unhandled errors return a
# stable JSON envelope instead of a traceback; logs carry the traceback either way.
DEBUG=false

# Fills the queue with demo tickets when the table is empty. Set to false for a
# genuinely empty database.
SEED_DEMO_DATA=true

# Browser origins allowed to call the API. Must be JSON when overridden from the
# environment. Both entries matter: 127.0.0.1 is a different origin than localhost.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# The browser (not the compose network) calls the API, so this must be a
# host-reachable address.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Only needed when running the API outside Docker (host -> published port).
# DATABASE_URL=postgresql+psycopg2://tickets:tickets@localhost:5432/tickets
